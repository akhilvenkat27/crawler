<%- include('partials/header', { page: page, title: 'Add connector — Crawler' }) %>

<section class="max-w-2xl mx-auto space-y-6">
  <a href="/connectors" class="text-xs text-ink-500 hover:text-ink-800">← Back to connectors</a>

  <% if (!provider) { %>
    <div class="space-y-3">
      <h2 class="text-[22px] font-semibold tracking-tight text-ink-900">Pick a provider</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% catalog.forEach(function(p){ %>
          <a href="/connectors/new?provider=<%= p.key %>" class="rounded-xl border border-ink-200 bg-white p-5 shadow-card hover:shadow-soft hover:border-ink-300">
            <div class="font-semibold text-ink-900"><%= p.name %></div>
            <div class="text-xs text-ink-500 mt-1"><%= p.description %></div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } else { %>
    <div>
      <h2 class="text-[22px] font-semibold tracking-tight text-ink-900"><%= connector ? 'Edit' : 'Connect' %> <%= provider.name %></h2>
      <p class="text-sm text-ink-500 mt-1"><%= provider.description %></p>
      <% if (provider.docsUrl) { %>
        <a href="<%= provider.docsUrl %>" target="_blank" rel="noopener" class="text-xs text-brand-700 hover:underline mt-1 inline-block">View provider docs →</a>
      <% } %>
    </div>

    <form id="connector-form" class="rounded-2xl border border-ink-200 bg-white shadow-card overflow-hidden" data-provider="<%= provider.key %>" <% if (connector) { %>data-id="<%= connector._id %>"<% } %>>
      <div class="p-6 space-y-5">
        <div>
          <label class="block text-xs font-medium text-ink-500 mb-1.5 uppercase tracking-wider">Label</label>
          <input name="label" type="text" placeholder="My <%= provider.name %>" value="<%= connector ? connector.label : '' %>" class="w-full px-3 py-2.5 text-sm rounded-lg border border-ink-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
        </div>

        <div class="border-t border-ink-100 pt-5">
          <div class="text-[11px] uppercase tracking-wider text-ink-400 font-medium mb-3">Credentials</div>
          <div class="space-y-4">
            <% provider.credentialFields.forEach(function(f){ %>
              <div>
                <label class="block text-sm text-ink-700 mb-1.5"><%= f.label %><% if (f.required) { %> <span class="text-red-500">*</span><% } %></label>
                <input
                  data-credential="<%= f.name %>"
                  type="<%= f.type === 'password' ? 'password' : 'text' %>"
                  placeholder="<%= f.placeholder || '' %>"
                  <% if (connector && f.type !== 'password' && connector.credentials && connector.credentials[f.name]) { %>value="<%= connector.credentials[f.name] %>"<% } %>
                  <% if (connector && f.type === 'password') { %>placeholder="•••••••• (leave blank to keep current)"<% } %>
                  class="w-full px-3 py-2.5 text-sm rounded-lg border border-ink-200 font-mono focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none"
                />
                <% if (f.help) { %><p class="text-[11px] text-ink-400 mt-1"><%= f.help %></p><% } %>
              </div>
            <% }); %>
          </div>
        </div>

        <% if (provider.optionFields && provider.optionFields.length) { %>
          <div class="border-t border-ink-100 pt-5">
            <div class="text-[11px] uppercase tracking-wider text-ink-400 font-medium mb-3">Defaults</div>
            <div class="space-y-3">
              <% provider.optionFields.forEach(function(f){
                   const val = connector && connector.config ? connector.config[f.name] : f.default; %>
                <div class="flex items-center justify-between gap-3">
                  <label class="text-sm text-ink-700"><%= f.label %></label>
                  <% if (f.type === 'boolean') { %>
                    <input data-config="<%= f.name %>" type="checkbox" <%= val !== false ? 'checked' : '' %> class="rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
                  <% } else if (f.type === 'number') { %>
                    <input data-config="<%= f.name %>" type="number" min="<%= f.min ?? '' %>" max="<%= f.max ?? '' %>" value="<%= val ?? '' %>" class="w-32 px-2 py-1.5 text-sm rounded border border-ink-200" />
                  <% } else { %>
                    <input data-config="<%= f.name %>" type="text" value="<%= val ?? '' %>" class="w-48 px-2 py-1.5 text-sm rounded border border-ink-200" />
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
      <div class="px-6 py-4 bg-ink-50/60 border-t border-ink-200/70 flex items-center justify-between">
        <div id="form-message" class="text-xs text-ink-500"></div>
        <div class="flex items-center gap-2">
          <a href="/connectors" class="px-3 py-2 text-sm rounded-lg border border-ink-200 hover:bg-ink-50">Cancel</a>
          <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-brand-600 hover:bg-brand-700 text-white shadow-soft">
            <%= connector ? 'Save changes' : 'Test & save' %>
          </button>
        </div>
      </div>
    </form>
  <% } %>
</section>

<script src="/js/connector-form.js"></script>
<%- include('partials/footer') %>
