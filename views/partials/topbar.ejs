<header class="h-[68px] px-8 border-b border-ink-200/70 bg-white/70 backdrop-blur-sm flex items-center justify-between">
  <div class="flex items-center gap-3">
    <% const titles = { dashboard: 'Dashboard', jobs: 'Crawl jobs', connectors: 'Connectors' }; %>
    <h1 class="text-[15px] font-semibold tracking-tight text-ink-900"><%= titles[page] || 'Crawler' %></h1>
    <span class="hidden md:inline-flex items-center gap-1.5 text-[11px] text-ink-500 px-2 py-0.5 rounded-full bg-ink-100">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span> system healthy
    </span>
  </div>
  <div class="flex items-center gap-2">
    <a href="/connectors/new" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg border border-ink-200 hover:bg-ink-50 text-ink-700">
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Add connector
    </a>
    <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg bg-ink-900 text-white hover:bg-ink-800">
      New crawl
    </a>
  </div>
</header>
