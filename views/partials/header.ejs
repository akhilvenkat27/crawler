<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Crawler — Dashboard' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=typography,forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace'],
          },
          colors: {
            ink: { 900:'#0b1220',800:'#111827',700:'#1f2937',500:'#4b5563',400:'#6b7280',300:'#9ca3af',200:'#e5e7eb',100:'#f3f4f6',50:'#f9fafb' },
            brand: { 50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',400:'#34d399',500:'#10b981',600:'#059669',700:'#047857' },
          },
          boxShadow: {
            card: '0 1px 2px rgba(16,24,40,.04), 0 1px 3px rgba(16,24,40,.06)',
            soft: '0 8px 24px -12px rgba(16,24,40,.12)',
          },
        },
      },
    };
  </script>
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="min-h-screen bg-[#fafafa] text-ink-800 antialiased">
  <div class="flex min-h-screen">
    <%- include('sidebar', { page: page }) %>
    <main class="flex-1 min-w-0 flex flex-col">
      <%- include('topbar', { page: page }) %>
      <div class="px-8 py-7 max-w-[1400px] mx-auto w-full">
