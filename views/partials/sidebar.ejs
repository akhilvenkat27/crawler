<aside class="w-[260px] shrink-0 border-r border-ink-200/70 bg-white/60 backdrop-blur-sm flex flex-col">
  <div class="h-[68px] px-6 flex items-center gap-2.5 border-b border-ink-200/70">
    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-soft">
      <svg viewBox="0 0 24 24" class="w-4.5 h-4.5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
    </div>
    <div class="leading-tight">
      <div class="font-semibold text-ink-900 tracking-tight">Crawler</div>
      <div class="text-[11px] text-ink-400">v0.1 · single-node</div>
    </div>
  </div>

  <nav class="px-4 py-5 flex-1 space-y-6">
    <div>
      <div class="px-3 mb-2 text-[11px] uppercase tracking-wider text-ink-400 font-medium">Workspace</div>
      <ul class="space-y-1">
        <% const navItems = [
            { key: 'dashboard',  href: '/',           label: 'Dashboard',  icon: '<path d="M3 12L12 3l9 9"/><path d="M5 10v10h14V10"/>' },
            { key: 'jobs',       href: '/jobs',       label: 'Crawl jobs', icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
            { key: 'connectors', href: '/connectors', label: 'Connectors', icon: '<path d="M9 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h4"/><path d="M15 17h4a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-4"/><path d="M9 12h6"/>' },
        ]; %>
        <% navItems.forEach(function(item){ %>
          <li>
            <a href="<%= item.href %>" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm <%= page === item.key ? 'bg-ink-900 text-white shadow-soft' : 'text-ink-700 hover:bg-ink-100/70' %>">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg>
              <span class="font-medium tracking-tight"><%= item.label %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    </div>

    <div>
      <div class="px-3 mb-2 text-[11px] uppercase tracking-wider text-ink-400 font-medium">Help</div>
      <ul class="space-y-1">
        <li>
          <a href="https://developers.cloudflare.com/browser-rendering/" target="_blank" rel="noopener" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-ink-700 hover:bg-ink-100/70">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 1-1 1.7"/><circle cx="12" cy="17" r=".5"/></svg>
            <span class="font-medium tracking-tight">Provider docs</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="p-4 border-t border-ink-200/70">
    <div class="flex items-center gap-3 px-2 py-1.5">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-ink-200 to-ink-100 flex items-center justify-center text-ink-700 text-xs font-semibold">
        <%= (user.name || user.email).slice(0,1).toUpperCase() %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium text-ink-900 truncate"><%= user.name || 'Demo User' %></div>
        <div class="text-[11px] text-ink-400 truncate"><%= user.email %></div>
      </div>
    </div>
  </div>
</aside>
