<%- include('partials/header', { page: page, title: 'Connectors — Crawler' }) %>

<section class="space-y-6">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <h2 class="text-[22px] font-semibold tracking-tight text-ink-900">Connectors</h2>
      <p class="text-sm text-ink-500 mt-1">Add provider credentials, enable or disable them, and run crawls through any active connector.</p>
    </div>
    <a href="/connectors/new" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm rounded-lg bg-ink-900 text-white hover:bg-ink-800 self-start">
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Add connector
    </a>
  </div>

  <div>
    <div class="text-[11px] uppercase tracking-wider text-ink-400 font-medium mb-3">Available providers</div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% catalog.forEach(function(p){ %>
        <a href="/connectors/new?provider=<%= p.key %>" class="group rounded-xl border border-ink-200 bg-white p-5 shadow-card hover:shadow-soft hover:border-ink-300 transition">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-white border border-ink-200 flex items-center justify-center overflow-hidden">
              <% if (p.iconUrl) { %>
                <img src="<%= p.iconUrl %>" alt="<%= p.name %>" class="w-7 h-7 object-contain" />
              <% } else { %>
                <span class="text-sm font-semibold text-ink-700"><%= p.name.slice(0,1) %></span>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-ink-900 tracking-tight"><%= p.name %></div>
              <div class="text-xs text-ink-500 mt-0.5 line-clamp-2"><%= p.description %></div>
            </div>
            <span class="text-ink-300 group-hover:text-ink-700 transition">→</span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>

  <div>
    <div class="text-[11px] uppercase tracking-wider text-ink-400 font-medium mb-3">Your connectors</div>
    <% if (connectors.length === 0) { %>
      <div class="rounded-xl border border-dashed border-ink-200 bg-white p-10 text-center">
        <div class="text-sm text-ink-500">No connectors configured yet.</div>
      </div>
    <% } else { %>
      <div class="rounded-xl border border-ink-200 bg-white shadow-card overflow-hidden">
        <table class="w-full text-sm">
          <thead class="text-[11px] uppercase tracking-wider text-ink-400">
            <tr class="border-b border-ink-200/70">
              <th class="text-left font-medium px-5 py-3">Label</th>
              <th class="text-left font-medium px-5 py-3">Provider</th>
              <th class="text-left font-medium px-5 py-3">Status</th>
              <th class="text-left font-medium px-5 py-3">Last test</th>
              <th class="text-right font-medium px-5 py-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% connectors.forEach(function(c){ %>
              <tr class="border-b border-ink-100/80 last:border-0" data-connector-row="<%= c._id %>">
                <td class="px-5 py-3 font-medium text-ink-900"><%= c.label || c.provider %></td>
                <td class="px-5 py-3 text-ink-600"><%= c.provider %></td>
                <td class="px-5 py-3">
                  <button data-toggle="<%= c._id %>" class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-1 rounded-full <%= c.enabled ? 'bg-brand-50 text-brand-700' : 'bg-ink-100 text-ink-600' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= c.enabled ? 'bg-brand-500' : 'bg-ink-400' %>"></span>
                    <span data-toggle-label><%= c.enabled ? 'enabled' : 'disabled' %></span>
                  </button>
                </td>
                <td class="px-5 py-3 text-xs text-ink-500">
                  <% if (c.lastTestStatus === 'ok') { %>
                    <span class="text-brand-700">✓ ok</span>
                    <span class="text-ink-400"><%= c.lastTestedAt ? new Date(c.lastTestedAt).toLocaleString() : '' %></span>
                  <% } else if (c.lastTestStatus === 'error') { %>
                    <span class="text-red-600">✗ error</span>
                    <span class="text-ink-400" title="<%= c.lastTestMessage %>"><%= c.lastTestMessage.slice(0,40) %></span>
                  <% } else { %>
                    <span class="text-ink-400">untested</span>
                  <% } %>
                </td>
                <td class="px-5 py-3 text-right space-x-2">
                  <button data-test="<%= c._id %>" class="text-xs px-2 py-1 rounded border border-ink-200 hover:bg-ink-50">Test</button>
                  <a href="/connectors/<%= c._id %>/edit" class="text-xs px-2 py-1 rounded border border-ink-200 hover:bg-ink-50">Edit</a>
                  <button data-delete="<%= c._id %>" class="text-xs px-2 py-1 rounded border border-red-200 text-red-600 hover:bg-red-50">Delete</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<script src="/js/connectors.js"></script>
<%- include('partials/footer') %>
